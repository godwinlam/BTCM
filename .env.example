# ========================================================
# BTCM Client Environment Configuration Template
# ========================================================
# Note: In Expo, variables accessible in application code
# must start with "EXPO_PUBLIC_"

# 1. Local Development (Web browser / Emulator)
# EXPO_PUBLIC_API_URL=http://localhost:5000/api

# 2. Testing on Physical Mobile Device (Expo Go via LAN)
# Replace with your PC's Wi-Fi / LAN IP (Run `ipconfig` on Windows)
# EXPO_PUBLIC_API_URL=http://192.168.1.112:5000/api

# 3. Remote Staging Backend
# EXPO_PUBLIC_API_URL=https://staging-api.yourdomain.com/api

# 4. Production Backend
# EXPO_PUBLIC_API_URL=https://api.yourdomain.com/api
